{
	"id": "service_withdrawal",
	"title": "A Regional Service Is Withdrawn",
	"text": "The regional provider announces that the local branch will close. The service remains available—if residents can travel far enough to reach it.",
	"trigger": {
		"type": "always"
	},
	"options": [
		{
			"text": "Replace the service with a municipal alternative",
			"cost": 7,
			"effects": [
				{
					"type": "demand_delta",
					"demand": "appeal",
					"amount": -2
				}
			]
		},
		{
			"text": "Fund a reduced local branch",
			"cost": 1,
			"effects": [
				{
					"type": "demand_delta",
					"demand": "appeal",
					"amount": 1
				}
			]
		},
		{
			"text": "Accept the withdrawal",
			"cost": 0,
			"effects": [
				{
					"type": "demand_delta",
					"demand": "appeal",
					"amount": 2
				},
				{
					"type": "resource_delta",
					"resource": "population_count",
					"amount": -100
				}
			]
		}
	]
}
